# ─── Обязательное ────────────────────────────────────────────────────────────

# SQLite для локального MVP. Для PostgreSQL:
#   DATABASE_URL="postgresql://lifeos:lifeos@localhost:5432/lifeos?schema=public"
#   и поменяй provider на "postgresql" в prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Секрет для подписи сессионных cookie. Сгенерируй: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

APP_URL="http://localhost:3000"
DEFAULT_TIMEZONE="Europe/Helsinki"

# ─── AI (опционально) ────────────────────────────────────────────────────────
# Без ключа система работает: Inbox Agent переключается на локальный парсер,
# планировщик и проверки полностью детерминированные.

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
ANTHROPIC_EFFORT="high"          # low | medium | high | xhigh | max

# Защита от бесконтрольных циклов и неожиданных счетов
AI_MAX_STEPS="6"
AI_MAX_COST_USD_PER_RUN="1.5"
AI_MAX_RUNS_PER_HOUR="60"

# ─── Telegram (опционально) ──────────────────────────────────────────────────
# 1. Создай бота у @BotFather, скопируй токен.
# 2. Задай секрет и повесь webhook:
#    curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<APP_URL>/api/telegram/webhook&secret_token=<SECRET>"
# 3. TELEGRAM_ALLOWED_CHAT_ID — свой chat id, чтобы бот не отвечал посторонним.

TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_ALLOWED_CHAT_ID=""

# ─── Google Calendar (опционально) ───────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Разрешённый redirect URI должен совпадать с GOOGLE_REDIRECT_URI.

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# ─── Seed (опционально) ──────────────────────────────────────────────────────
SEED_EMAIL="emiliya.shramkoo@gmail.com"
SEED_PASSWORD="lifeos123"
